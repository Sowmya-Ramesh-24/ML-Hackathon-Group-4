# PathSnap backend configuration. Copy to .env or export these variables.

# Pipeline mode: "mock" (labelled demo data, no teammate code needed) or
# "real" (loads the actual Person 1/2/3 pipeline through the adapter).
PATHSNAP_MODE=mock

# REAL MODE ONLY: import path of the teammates' integration module, e.g.
# teammates_pipeline  (a teammates_pipeline.py on PYTHONPATH)
# or a file path: /home/user/team/teammates_pipeline.py
# See docs/INTEGRATION_CONTRACT.md for the functions this module must provide.
PATHSNAP_TEAMMATES_MODULE=

# REAL MODE ONLY: server-side directory holding datasets and evaluator
# reference routes. Contents are never served statically.
PATHSNAP_DATA_DIR=./data

# CORS. For the two-laptop demo the frontend is opened from another machine,
# so the origin will differ. "*" is acceptable for a closed classroom LAN;
# restrict to known origins otherwise.
PATHSNAP_CORS_ORIGINS=*

# Set to "true" to include reference-route geometry in the evaluate response
# (only ever returned AFTER a prediction has been run for that trip).
PATHSNAP_RETURN_REFERENCE_GEOMETRY=true

# Network bind. 0.0.0.0 makes the API reachable from Laptop 2 on the LAN.
PATHSNAP_HOST=0.0.0.0
PATHSNAP_PORT=8000
